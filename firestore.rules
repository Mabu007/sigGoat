rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Whether the signed-in user belongs to a room.
     *
     * The membership row id is "<roomId>_<uid>". Both parts are already
     * safe for a document id, so the path below is the row the server
     * wrote.
     */
    function isRoomMember(roomId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/roomMembers/$(roomId + '_' + request.auth.uid));
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // A credential document id is "<userId>_<provider>". Verified against the
    // signed-in uid so a crafted id cannot reach another user's record.
    function isOwnedByUser(recordId, uid) {
      return recordId is string && recordId.matches('^' + uid.replace('.', '\\.') + '_.+$');
    }

    // Shape of an AES-256-GCM credential envelope: five dot-separated parts,
    // version, key id, nonce, ciphertext, tag. Anything else is not something
    // the vault wrote.
    function isValidEnvelope(value) {
      return value is string
             && value.size() > 0
             && value.size() <= 4096
             && value.matches('^v1\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]*\\.[A-Za-z0-9_-]+$');
    }

    function existing() {
      return resource.data;
    }

    /**
     * A moment in time.
     *
     * The client writes profile timestamps with `serverTimestamp()`, which
     * Firestore resolves to a timestamp, while the server writes ISO
     * strings. Both are legitimate, so both are accepted — a rule that only
     * allowed one of them would silently block the other writer.
     */
    function isValidTimestamp(value) {
      return value is string || value is timestamp;
    }

    /**
     * A reference to an image in the media bucket.
     *
     * Only the OBJECT KEY is stored. The delivery url is signed and
     * regenerated by the server on every read, so a stored url would be a
     * broken image the moment it expired.
     */
    function isValidMediaRef(value) {
      return value is map
        && value.keys().hasAll(['key', 'contentType', 'size', 'updatedAt'])
        && value.key is string
        && value.key.size() > 0
        && value.key.size() <= 200
        && value.key.matches('^(avatars|covers)/[A-Za-z0-9_-]+/[A-Za-z0-9._-]+$')
        && value.contentType is string
        && value.contentType.matches('^image/(png|jpeg|webp|gif)$')
        && value.size is number
        && value.size > 0
        && value.size <= 4194304
        && isValidTimestamp(value.updatedAt);
    }

    function isValidUserProfile(data) {
      return data.id is string && data.id.size() <= 128
        && data.email is string && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('telegramChatId' in data) || (data.telegramChatId is string && data.telegramChatId.size() <= 64))
        && (!('telegramUsername' in data) || (data.telegramUsername is string && data.telegramUsername.size() <= 64))
        && (!('telegramNotificationsEnabled' in data) || (data.telegramNotificationsEnabled is bool))
        && (!('photo' in data) || data.photo == null || isValidMediaRef(data.photo))
        && isValidTimestamp(data.createdAt)
        && isValidTimestamp(data.updatedAt);
    }

    function isValidGoat(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.goal is string && data.goal.size() > 0 && data.goal.size() <= 1000
        && data.markets is list && data.markets.size() <= 20
        && data.skillIds is list && data.skillIds.size() <= 20
        && data.model is string && data.model.size() <= 100
        && data.status is string && data.status in ['ACTIVE', 'WATCHING', 'DORMANT', 'INVESTIGATING', 'PAUSED']
        && data.createdAt is string
        && data.updatedAt is string;
    }

    function isValidSkill(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.description is string && data.description.size() <= 500
        && data.methodology is string && data.methodology.size() <= 2000
        && data.constraints is string && data.constraints.size() <= 1000
        && data.preferredTimeframes is list && data.preferredTimeframes.size() <= 10
        && data.requiredEvidence is string && data.requiredEvidence.size() <= 1000
        && data.invalidationRules is string && data.invalidationRules.size() <= 1000
        && data.createdAt is string
        && data.updatedAt is string;
    }

    function isValidThesis(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid
        && data.goatId is string && data.goatId.size() <= 128
        && data.market is string && data.market.size() <= 32
        && data.directionalHypothesis is string && data.directionalHypothesis in ['BULLISH', 'BEARISH', 'NEUTRAL']
        && data.supportingEvidence is list && data.supportingEvidence.size() <= 20
        && data.relevantTimeframe is string && data.relevantTimeframe.size() <= 32
        && data.confirmationConditions is list && data.confirmationConditions.size() <= 20
        && data.invalidationConditions is list && data.invalidationConditions.size() <= 20
        && data.confidence is number
        && data.status is string && data.status in ['FORMULATING', 'TRACKING', 'CONFIRMED', 'INVALIDATED', 'EXPIRED']
        && data.createdAt is string
        && data.updatedAt is string;
    }

    function isValidSignal(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid
        && data.goatId is string && data.goatId.size() <= 128
        && data.market is string && data.market.size() <= 32
        && data.direction is string && data.direction in ['LONG', 'SHORT', 'NO_TRADE']
        && data.confidence is number
        && data.thesis is string && data.thesis.size() <= 2000
        && data.rationale is string && data.rationale.size() <= 2000
        && data.invalidation is string && data.invalidation.size() <= 1000
        && data.status is string && data.status in ['ACTIONABLE', 'INVALIDATED', 'EXPIRED', 'NO_TRADE']
        && data.createdAt is string
        && data.updatedAt is string;
    }

    function isValidBacktest(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid
        && data.goatId is string && data.goatId.size() <= 128
        && data.market is string && data.market.size() <= 32
        && data.period is string && data.period.size() <= 32
        && data.totalSignals is number
        && data.winningSignals is number
        && data.losingSignals is number
        && data.winRate is number
        && data.createdAt is string;
    }

    // ------------------------------------------------------------------
    // CREDENTIALS (DEFENCE IN DEPTH)
    // ------------------------------------------------------------------
    //
    // The server writes these through the Admin SDK, which BYPASSES these
    // rules entirely. They exist so that if a client SDK is ever pointed at
    // Firestore directly — or a rule is copied elsewhere — it cannot read or
    // write another user's encrypted secrets.
    //
    // Document id is "<userId>_<provider>", and the body repeats `userId`, so
    // BOTH are checked. A mismatch means the id and the content disagree,
    // which is exactly what a crafted write would look like.
    //
    // The value here is an AES-256-GCM ENVELOPE ("v1.<keyId>.<nonce>…"), not
    // a plaintext key. `isValidEnvelope` enforces the shape so a client
    // cannot smuggle an arbitrary string into a field the server will later
    // attempt to decrypt and report on.
    match /credentials/{recordId} {
      allow get, list: if isSignedIn()
                       && isOwnedByUser(recordId, request.auth.uid)
                       && resource.data.userId == request.auth.uid
                       && isValidEnvelope(resource.data.envelope);

      // Denied by default. The server never asks the client to write here.
      allow create, update, delete: if false;
    }

    // Rules for collections
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming())
                    && incoming().id == existing().id && incoming().createdAt == existing().createdAt;
      allow delete: if isOwner(userId) && isValidId(userId);

      match /goats/{goatId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(goatId) && isValidGoat(incoming());
        allow update: if isOwner(userId) && isValidId(goatId) && isValidGoat(incoming())
                      && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(goatId);
      }

      match /skills/{skillId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(skillId) && isValidSkill(incoming());
        allow update: if isOwner(userId) && isValidId(skillId) && isValidSkill(incoming())
                      && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(skillId);
      }

      match /theses/{thesisId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(thesisId) && isValidThesis(incoming());
        allow update: if isOwner(userId) && isValidId(thesisId) && isValidThesis(incoming())
                      && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(thesisId);
      }

      match /signals/{signalId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(signalId) && isValidSignal(incoming());
        allow update: if isOwner(userId) && isValidId(signalId) && isValidSignal(incoming())
                      && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(signalId);
      }

      match /backtests/{backtestId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidBacktest(incoming());
        allow delete: if isOwner(userId);
       }

       // Where this member has read up to, per room.
       //
       // The cursor is written by the SERVER, from the messages the member
       // actually saw. If the browser could write it, a client could clear
       // another user's unread state, and a user could claim to have read a
       // conversation they never opened.
       match /readCursors/{roomId} {
        allow read: if isOwner(userId);
        allow write: if false;
       }

       // ------------------------------------------------------------------
       // CHATS (app-wide AI assistant)
       // ------------------------------------------------------------------
       // Chats and their messages are owned by a single user. Chat documents
       // sit at the top level under the user collection so each chat can be
       // addressed directly; messages live in a subcollection for cheap
       // pagination over long conversations. Both paths are enforced with the
       // same ownership model as the other user collections.
      match /chats/{chatId} {
        allow get, list: if isOwner(userId) && isValidId(chatId);
        allow create: if isOwner(userId) && isValidId(chatId)
                      && incoming().userId == request.auth.uid;
        allow update: if isOwner(userId) && isValidId(chatId)
                      && incoming().userId == request.auth.uid;
        allow delete: if isOwner(userId) && isValidId(chatId);

        match /messages/{messageId} {
          allow read: if isOwner(userId) && isValidId(messageId);
          allow create: if isOwner(userId) && isValidId(messageId)
                        && incoming().userId == request.auth.uid;
          allow delete: if isOwner(userId) && isValidId(messageId);
        }
      }
    }

    // ------------------------------------------------------------------
    // ROOM CONVERSATIONS AND MEMBERSHIP
    // ------------------------------------------------------------------
    // A trading room is a human-led community, so the server stores three
    // more kinds of document:
    //
    //   roomMembers/{roomId_userId} - who has joined which room
    //   chats/{chatId}              - a room conversation (kind 'room') or a
    //                                 private mentor thread (kind 'direct')
    //   chats/{chatId}/messages/... - the messages of either
    //
    // These live at the TOP level, which is where the server writes them, and
    // every one of them is reached through the server's own authorization
    // checks (membership for a room, the two participants for a private
    // thread). The browser never reads them directly, so the client rules
    // below DENY access outright: a rule that is never exercised cannot be
    // the thing that keeps a conversation private.
    match /roomMembers/{memberId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // ------------------------------------------------------------------
    // TRADINGVIBES ROOMS
    // ------------------------------------------------------------------
    // A room record lives at `goatTeams/{roomId}`. That is the collection
    // the product already used before the rebrand, so no room is orphaned
    // by the rename and no data has to be migrated.
    //
    // THE BROWSER NEVER READS OR WRITES A ROOM DIRECTLY.
    //
    // Every room read, every room setting change and every live session
    // transition goes through the API, which resolves the caller's role
    // from the room document and the membership collection. The rules
    // below therefore say "no" to the client for the room record itself.
    // A rule that is never exercised cannot be the thing that keeps a
    // private room private.
    match /goatTeams/{roomId} {
      allow read, write: if false;

      // Live session records: `goatTeams/{roomId}/sessions/{sessionId}`.
      // A member may read the room's session history; only the server
      // writes it.
      match /sessions/{sessionId} {
        allow read: if isRoomMember(roomId);
        allow write: if false;
      }

      // The durable copy of the shared chart state.
      match /chartState/{docId} {
        allow read: if isRoomMember(roomId);
        allow write: if false;
      }

      // Who is in the room's voice session. A participant may only ever
      // write their OWN row, and only while they are a member.
      match /voiceParticipants/{uid} {
        allow read: if isRoomMember(roomId);
        allow create, update: if isRoomMember(roomId) && request.auth.uid == uid;
        allow delete: if request.auth.uid == uid;
      }

      // Who holds a live connection right now.
      //
      // The Durable Object reports this and the server records it, so the
      // browser never writes it: a client that could write its own
      // presence would be able to make itself look online.
      match /presence/{docId} {
        allow read: if isRoomMember(roomId);
        allow write: if false;
      }
    }

    match /chats/{chatId} {
      allow get, list: if false;
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if false;
        allow create, update, delete: if false;
      }
    }
  }
}
