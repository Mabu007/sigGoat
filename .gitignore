node_modules/
build/
dist/
coverage/
.DS_Store
*.log

# Real secrets. .env.example is committed but must only ever contain empty
# placeholders for server-side values.
.env*
!.env.example

# Runtime state at the REPOSITORY ROOT. Contains each user's SAVED OpenRouter
# API key and Telegram bot token in plaintext — this must never enter version
# control.
#
# Anchored to the root with a leading slash on purpose. A bare `data/` also
# matches `src/data/`, which holds the DEFAULT SKILL LIBRARY source code that
# `src/server/apiRouter.ts` imports. Because that directory was ignored, every
# file in it was untracked, so a fresh clone could not build the API at all:
# the Git-connected deploy failed with "Could not resolve ../data/defaultSkills".
#
# The root-level path pattern `/data/` still ignores the local state file and
# `data/market-state/`, while leaving `src/data/` tracked.
/data/

# Firebase service-account downloads (never commit key material).
#
# Covers both the local-dev filename AND the console download pattern
# `<project>-firebase-adminsdk-<id>.json`, which the previous patterns missed.
firebase-service-account.json
*-service-account*.json
service-account.json
*-firebase-adminsdk-*.json
firebase-adminsdk-*.json

# Large scratch artefacts / local tooling output.
codebase.txt
.vercel

# Generated Vercel serverless bundle (built by `npm run build:api`).
#
# The bundle is NOT committed, but api/index.js IS: Vercel resolves the
# `functions` map in vercel.json before running the build command, so the entry
# point must exist in a fresh clone. api/index.js is a shim that re-exports the
# bundle built here. See api/index.js for the full explanation.
.api-build/
