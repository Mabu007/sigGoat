# ==================================================================
# SignalGOAT — environment contract
# ==================================================================
# There are TWO different kinds of variable here, with two different
# delivery mechanisms. Mixing them up is the #1 deployment mistake:
#
#   1. VITE_*  — PUBLIC, browser-visible, inlined by Vite AT BUILD TIME.
#      -> MUST be present when `vite build` runs.
#      -> Vercel dashboard "Build" settings (not "Environment Variables"),
#         OR committed here (values are designed to be public anyway).
#      -> Setting these only at runtime does NOTHING: the bundle is already
#         built.
#
#   2. everything else — SERVER SECRETS, never sent to the browser.
#      -> Set ONLY in the Vercel dashboard "Environment Variables".
#      -> NEVER commit a real value here. Empty placeholders only.
# ==================================================================


# ------------------------------------------------------------------
# 1. FIREBASE — PUBLIC WEB CONFIG (Vite build-time)
# ------------------------------------------------------------------
# These identify the web client. They are not secrets: Firebase ships them
# to every browser. They are committed deliberately so the app can be
# built anywhere, including CI and preview deploys.
#
# Firebase project: sirvibes-44204
VITE_FIREBASE_API_KEY="AIzaSyCy-6HhG5cih6csrVZaNQ5ul7F_tC-i3k0"
VITE_FIREBASE_AUTH_DOMAIN="sirvibes-44204.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="sirvibes-44204"
VITE_FIREBASE_STORAGE_BUCKET="sirvibes-44204.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="778526817917"
VITE_FIREBASE_APP_ID="1:778526817917:web:46e94afeef939180903b14"
VITE_FIREBASE_MEASUREMENT_ID="G-JBRHZ5YDKF"

# Only set this if you use a NON-DEFAULT Firestore database.
# sirvibes-44204 uses the default database, so leave this EMPTY.
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# Set to "true" while developing against http://localhost. NEVER in
# production: it permits OAuth redirects from any loopback port.
VITE_FIREBASE_AUTH_EMULATORS="false"


# ------------------------------------------------------------------
# 2. FIREBASE — SERVER SERVICE ACCOUNT (Vercel env var only)
# ------------------------------------------------------------------
# The server must verify Firebase ID tokens and read/write Firestore.
# The public web keys above CANNOT do this. Generate the JSON from:
#   Firebase console -> Project settings -> Service accounts ->
#   "Generate new private key"
#
# Vercel stores multi-line env vars poorly, so prefer the BASE64 form.
# Generate it locally with:
#   base64 -w0 firebase-service-account.json
#
# Then set ONLY this one variable in Vercel.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=""

# Fallback for local development, where a real multi-line .json file is
# fine. Point at a git-ignored file. Ignored if the BASE64 form is set.
GOOGLE_APPLICATION_CREDENTIALS=""

# Alternative: use Application Default Credentials (Cloud Run / GCE).
# Only needs the project id; no JSON required.
FIREBASE_PROJECT_ID=""


# ------------------------------------------------------------------
# 3. REASONING (Vercel env var only)
# ------------------------------------------------------------------
# Server-wide fallback key. Per-user BYOK keys saved in Settings take
# precedence and are resolved per request.
OPENROUTER_API_KEY=""


# ------------------------------------------------------------------
# 4. TELEGRAM (Vercel env var only)
# ------------------------------------------------------------------
# Server-wide fallback bot token; per-user tokens (Settings) win.
TELEGRAM_BOT_TOKEN=""

# When set, POST /api/telegram/webhook requires a matching
# x-telegram-bot-api-secret-token header.
TELEGRAM_WEBHOOK_SECRET=""


# ------------------------------------------------------------------
# 5. CLOUDFLARE DURABLE OBJECTS
# ------------------------------------------------------------------
# SignalGOAT runs on TWO platforms with SEPARATE secret stores. This is the
# single most common deployment mistake: setting a value in one place and
# assuming the other platform can see it.
#
#   Vercel        — web UI, API routes, Firebase, OpenRouter, Telegram.
#   Cloudflare    — one Worker holding two Durable Object classes:
#                     GoatSchedulerDO  per-GOAT alarm + schedule (per GOAT id)
#                     MarketDataDO     canonical 1m candles, per instrument class
#
# Deploy the Worker with:  npx wrangler deploy
# Then set the SAME secret under the platform-specific names below.
#
#   Cloudflare:  npx wrangler secret put SCHEDULER_SECRET
#   Vercel:      DURABLE_SCHEDULER_SECRET=<same value>
#
# They are deliberately different NAMES on each side — the Worker and the app
# are separate deployments with separate secret stores — but they must hold the
# same BYTES.
#
#   Vercel sends it as `Authorization: Bearer <value>`;
#   the Worker sends it back as `X-Scheduler-Secret` on alarm callbacks.

# --- Vercel (the application) ---
# Base URL of the deployed Cloudflare Worker, e.g.
#   https://siggoat-scheduler.<subdomain>.workers.dev
DURABLE_SCHEDULER_URL=""

# Shared secret. Leave EMPTY to run without the Worker (in-process timers).
# Generate one with:  openssl rand -hex 32
DURABLE_SCHEDULER_SECRET=""

# --- Cloudflare (the Worker) ---
# Set with:  npx wrangler secret put SCHEDULER_SECRET
SCHEDULER_SECRET=""

# Base URL of THIS Vercel application. The Worker POSTs alarm deliveries back
# here at /api/internal/wake and /api/internal/check-trackers.
# Example: https://siggoat.vercel.app
APP_ORIGIN=""


# ------------------------------------------------------------------
# 5b. MARKET DATA DURABLE OBJECT (optional but recommended)
# ------------------------------------------------------------------
# The canonical home for one-minute candles, session summaries and the swing
# / level ledger. It is the component that enforces bounded retention and the
# "never delete a candle before its summary is persisted" invariant in
# PRODUCTION, where a Vercel function cannot.
#
# These are SEPARATE from SCHEDULER_SECRET above on purpose: they authenticate
# market-data traffic rather than scheduler traffic, so the two surfaces can be
# rotated independently and a leaked market secret cannot schedule GOAT wakes.
#
# If BOTH are unset, the app falls back to its in-process ingestion service. It
# works, but a serverless cold start starts from an empty store — which is
# reported as `durableMarketData.configured: false`.
#
#   MARKET_DATA_WORKER_URL must be the same Worker URL as above.
MARKET_DATA_WORKER_URL=""
MARKET_DATA_WORKER_SECRET=""


# ------------------------------------------------------------------
# 5c. RETENTION POLICY (optional)
# ------------------------------------------------------------------
# Defaults are chosen so an unconfigured deployment is still bounded. Every
# value is validated; an unparseable value falls back to the default rather
# than disabling retention.
#
#   RETENTION_H1_DAYS=7            1h candles retained (default 7 days)
#   RETENTION_D1_DAYS=180          1d candles retained (default 180 days)
#   RETENTION_M5_ENABLED=false     materialise 5m candles (default OFF:
#                                   they are derived from 1m on demand)
#   RETENTION_M5_SESSIONS=3        5m sessions retained when enabled
#   RETENTION_SESSION_SUMMARIES=400 summaries kept per instrument
#   RETENTION_SWING_POINTS=250     confirmed swing points kept per side
#   RETENTION_LATE_GRACE_MINUTES=3 grace window for late provider corrections
#   RETENTION_PRUNE_BATCH=2000     max candles deleted per pruning pass
RETENTION_H1_DAYS="7"
RETENTION_D1_DAYS="180"
RETENTION_M5_ENABLED="false"
RETENTION_M5_SESSIONS="3"
RETENTION_SESSION_SUMMARIES="400"
RETENTION_SWING_POINTS="250"
RETENTION_LATE_GRACE_MINUTES="3"
RETENTION_PRUNE_BATCH="2000"


# ------------------------------------------------------------------
# 5d. CLOUDFLARE ACCOUNT (only needed to run `wrangler deploy`)
# ------------------------------------------------------------------
# Local `wrangler deploy` authenticates through `wrangler login`. These are
# only required for CI or non-interactive deploys.
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""


# ------------------------------------------------------------------
# 6. LOCAL DEVELOPMENT ONLY
# ------------------------------------------------------------------
# Explicit opt-in for running WITHOUT Firebase credentials.
# Accepts a plain x-dev-user-id header as identity.
# NEVER enable this in production.
SIGNALGOAT_ALLOW_DEV_AUTH="0"

# File-backed persistence directory when Firestore is unavailable.
DATA_DIR="./data"

PORT="3000"


# ------------------------------------------------------------------
# 7. GEMINI (Vercel env var only, optional)
# ------------------------------------------------------------------
GEMINI_API_KEY=""
APP_URL=""
