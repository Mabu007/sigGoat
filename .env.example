# ==================================================================
# SIRGOAT — environment contract
# ==================================================================
# There are TWO different kinds of variable here, with two different
# delivery mechanisms. Mixing them up is the #1 deployment mistake:
#
#   1. VITE_*  — PUBLIC, browser-visible, inlined by Vite AT BUILD TIME.
#      -> MUST be present when `vite build` runs.
#      -> Vercel dashboard "Build" settings (not "Environment Variables"),
#         OR committed here (values are designed to be public anyway).
#      -> Setting these only at runtime does NOTHING: the bundle is already
#         built.
#
#   2. everything else — SERVER SECRETS, never sent to the browser.
#      -> Set ONLY in the Vercel dashboard "Environment Variables".
#      -> NEVER commit a real value here. Empty placeholders only.
# ==================================================================


# ------------------------------------------------------------------
# 1. FIREBASE — PUBLIC WEB CONFIG (Vite build-time)
# ------------------------------------------------------------------
# These identify the web client. They are not secrets: Firebase ships them
# to every browser. They are committed deliberately so the app can be
# built anywhere, including CI and preview deploys.
#
# Firebase project: sirvibes-44204
VITE_FIREBASE_API_KEY="AIzaSyCy-6HhG5cih6csrVZaNQ5ul7F_tC-i3k0"
VITE_FIREBASE_AUTH_DOMAIN="sirvibes-44204.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="sirvibes-44204"
VITE_FIREBASE_STORAGE_BUCKET="sirvibes-44204.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="778526817917"
VITE_FIREBASE_APP_ID="1:778526817917:web:46e94afeef939180903b14"
VITE_FIREBASE_MEASUREMENT_ID="G-JBRHZ5YDKF"

# Only set this if you use a NON-DEFAULT Firestore database.
# sirvibes-44204 uses the default database, so leave this EMPTY.
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# Set to "true" while developing against http://localhost. NEVER in
# production: it permits OAuth redirects from any loopback port.
VITE_FIREBASE_AUTH_EMULATORS="false"


# ------------------------------------------------------------------
# 2. FIREBASE — SERVER SERVICE ACCOUNT (API host env var only)
# ------------------------------------------------------------------
# The server must verify Firebase ID tokens and read/write Firestore.
# The public web keys above CANNOT do this. Generate the JSON from:
#   Firebase console -> Project settings -> Service accounts ->
#   "Generate new private key"
#
# Vercel stores multi-line env vars poorly, so prefer the BASE64 form.
# Generate it locally with:
#   base64 -w0 firebase-service-account.json
#
# Then set ONLY this one variable in Vercel.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=""

# Fallback for local development, where a real multi-line .json file is
# fine. Point at a git-ignored file. Ignored if the BASE64 form is set.
GOOGLE_APPLICATION_CREDENTIALS=""

# Alternative: use Application Default Credentials when supported by the API host.
# Only needs the project id; no JSON required.
FIREBASE_PROJECT_ID=""


# ------------------------------------------------------------------
# 3. REASONING (API host env var only)
# ------------------------------------------------------------------
# Server-wide fallback key. Per-user BYOK keys saved in Settings take
# precedence and are resolved per request.
OPENROUTER_API_KEY=""


# ------------------------------------------------------------------
# 4. TELEGRAM (API host env var only)
# ------------------------------------------------------------------
# Server-wide fallback bot token; per-user tokens (Settings) win.
TELEGRAM_BOT_TOKEN=""

# When set, POST /api/telegram/webhook requires a matching
# x-telegram-bot-api-secret-token header.
TELEGRAM_WEBHOOK_SECRET=""


# ------------------------------------------------------------------
# ------------------------------------------------------------------
# 4b. cTRADER OPEN API (API host env vars only — keep secret)
# ------------------------------------------------------------------
# Register this exact redirect URI in the cTrader Open API application.
# CTRADER_CLIENT_ID and CTRADER_SECRET are server-only; never use VITE_ names.
CTRADER_CLIENT_ID=""
CTRADER_SECRET=""
CTRADER_REDIRECT_URI=""

# Order submission is disabled unless explicitly enabled. Keep false/unset
# while validating OAuth, quotes, candles and demo-account order behavior.
CTRADER_EXECUTION_ENABLED="false"

# Public app origin, used when registering the Telegram webhook.
APP_ORIGIN=""
CRON_SECRET=""


# 5c. RETENTION POLICY (optional)
# ------------------------------------------------------------------
# Defaults are chosen so an unconfigured deployment is still bounded. Every
# value is validated; an unparseable value falls back to the default rather
# than disabling retention.
#
#   RETENTION_H1_DAYS=7            1h candles retained (default 7 days)
#   RETENTION_D1_DAYS=180          1d candles retained (default 180 days)
#   RETENTION_M5_ENABLED=false     materialise 5m candles (default OFF:
#                                   they are derived from 1m on demand)
#   RETENTION_M5_SESSIONS=3        5m sessions retained when enabled
#   RETENTION_SESSION_SUMMARIES=400 summaries kept per instrument
#   RETENTION_SWING_POINTS=250     confirmed swing points kept per side
#   RETENTION_LATE_GRACE_MINUTES=3 grace window for late provider corrections
#   RETENTION_PRUNE_BATCH=2000     max candles deleted per pruning pass
RETENTION_H1_DAYS="7"
RETENTION_D1_DAYS="180"
RETENTION_M5_ENABLED="false"
RETENTION_M5_SESSIONS="3"
RETENTION_SESSION_SUMMARIES="400"
RETENTION_SWING_POINTS="250"
RETENTION_LATE_GRACE_MINUTES="3"
RETENTION_PRUNE_BATCH="2000"


# ------------------------------------------------------------------
# 6. LOCAL DEVELOPMENT ONLY
# ------------------------------------------------------------------
# Explicit opt-in for running WITHOUT Firebase credentials.
# Accepts a plain x-dev-user-id header as identity.
# NEVER enable this in production.
SIGNALGOAT_ALLOW_DEV_AUTH="0"

# File-backed persistence directory when Firestore is unavailable.
DATA_DIR="./data"

PORT="3000"


# ------------------------------------------------------------------
# 7. GROQ — TESTING / FALLBACK PROVIDER (API host env var only)
# ------------------------------------------------------------------
# Optional. Used when a user selects Groq as their provider, or for automated
# integration tests when OpenRouter has no usable free model for the caller.
#
# A user may instead configure their OWN Groq key in Settings, exactly like
# OpenRouter; the server variable is only a fallback.
#
# Not free, not interchangeable with OpenRouter model ids, and its request
# shape differs. It is normalised into the same internal ReasoningResult
# contract (see src/services/ai/GroqClient.ts).
GROQ_API_KEY=""


# ------------------------------------------------------------------
# 8. UNRELATED / UNUSED — DO NOT SET
# ------------------------------------------------------------------
# GEMINI_API_KEY, APP_URL, PRIVY_* and S3_API_KEY belong to other projects in
# the same workspace. No file in this repository reads them, and they have no
# effect here. They were previously present in this file with real values,
# which is a credential leak with no benefit — rotate anything that appeared
# here and leave these unset.


# ------------------------------------------------------------------
# 10. CREDENTIAL ENCRYPTION  (REQUIRED — SERVER ONLY)
# ------------------------------------------------------------------
# The master key for the credential vault. Every user-supplied secret
# (OpenRouter, Groq, PropDAO, Telegram bot token) is encrypted with
# AES-256-GCM under this key before it is stored, and is only ever decrypted
# server-side, in memory, to make an outbound request.
#
# FORMAT: exactly 32 bytes, as base64, base64url, or 64 hex characters.
#   openssl rand -base64 32
#
# REQUIRED. Without it the app runs, but every credential save FAILS with
# ENCRYPTION_NOT_CONFIGURED rather than storing anything in plaintext.
#
# NEVER put this in a VITE_* variable. Those are compiled into the browser
# bundle. NEVER commit a real value.
#
# ROTATION: move the current value to CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS as
# "<oldId>:<oldKey>" and set a new CREDENTIAL_ENCRYPTION_KEY. Existing
# records keep decrypting under the old key while they are rewritten.
CREDENTIAL_ENCRYPTION_KEY=""
CREDENTIAL_ENCRYPTION_KEY_ID=""
CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS=""

# Escape hatch for a fresh `npm run dev` checkout, so the app is usable
# before you have generated a key. OFF BY DEFAULT, AND IT MUST STAY OFF ON
# ANY DEPLOYED ENVIRONMENT.
#
# When enabled and no master key is set, the vault generates a random key per
# PROCESS. On Vercel that means a new key on every cold start, so every
# credential a user has saved becomes permanently undecryptable — while
# /api/settings/keys still answers `configured: true`, because the vault
# itself works fine, it just no longer holds the key the data was written
# under. The failure is silent and looks like "my key just doesn't work".
#
# Leave this empty in production. If you see a vault warning in the logs,
# set a real CREDENTIAL_ENCRYPTION_KEY instead.
CREDENTIAL_ENCRYPTION_ALLOW_EPHEMERAL=""

# ------------------------------------------------------------------
# 11. PROPDAO  (SERVER ONLY)
# ------------------------------------------------------------------
# PropDAO API keys are PER-USER and stored in the vault above. There is
# deliberately no shared server-side PropDAO key: one shared key would let
# any user's request act on the account the key belongs to.
#
# No configuration is required to READ. The PropDAO settings panel works as
# soon as a user saves their own key.
#
# The base URL is only needed to point at a non-production environment.
PROPDAO_API_BASE_URL=""

# --- EXECUTION: OFF, AND IT MUST STAY OFF UNTIL AUTHORISED --------------
#
# PropDAO's Terms §10 grant access only for "personal, non-commercial use",
# and §9 prohibits "use automated systems without authorization". PropDAO's
# own Rulebook §4.2 permits automation for an individual trader, but nothing
# on propdao.finance authorises a THIRD PARTY operating a paid service on a
# customer's behalf. SIRGOAT is such a third party.
#
# All THREE variables below are required, and all three must be set before
# any order can be placed:
#   PROPDAO_EXECUTION_ENABLED     — the feature switch
#   PROPDAO_EXECUTION_AUTHORISED  — a standing assertion that commercial use
#                                  was checked and permitted
#   PROPDAO_EXECUTION_TERMS_REFERENCE — what that permission is (e.g. a dated
#                                  written approval from PropDAO)
#
# With any one of them absent, every write path returns EXECUTION_DISABLED
# and the UI says so. Read-only features (accounts, risk, positions,
# orders, trades, markets) are unaffected.
PROPDAO_EXECUTION_ENABLED="false"
PROPDAO_EXECUTION_AUTHORISED="false"
PROPDAO_EXECUTION_TERMS_REFERENCE=""

# ------------------------------------------------------------------
# 12. HYPERLIQUID  (SERVER ONLY, OPTIONAL)
# ------------------------------------------------------------------
# The default public info endpoint needs no key and no configuration.
# Override only to point at mainnet explicitly or at testnet.
#   mainnet: https://api.hyperliquid.xyz/info
#   testnet: https://api.hyperliquid-testnet.xyz/info
HYPERLIQUID_INFO_URL=""

# ------------------------------------------------------------------
# 13. AUTH  (SERVER ONLY)
# ------------------------------------------------------------------
# Dev auth identifies a caller by a caller-supplied x-dev-user-id header.
# It exists so the app can be run and demoed without Firebase Admin
# credentials.
#
# WHEN IT IS USED
#   Only when there is NO Firebase Admin credential. If Firebase is
#   configured, Firebase wins and this variable is ignored — dev auth can
#   never downgrade a properly configured deployment.
#
# WHAT IT COSTS
#   Anyone who can reach the server can act as anyone. In production that
#   is a real exposure, so it is logged as a warning at boot and reported
#   on GET /api/settings/status as `platform.devAuthEnabled`.
#
# WHAT IT DOES TO DATA
#   With no Firebase Admin credential there is no durable datastore. The
#   app then runs on file storage, which does NOT survive a redeploy or a
#   cold start. It says so: `platform.persistenceDegradedReason`.
#
#   Without this variable, a production runtime with no datastore REFUSES
#   every write with a 503 and the real reason, rather than accepting
#   writes and losing them.
#
# THE RIGHT FIX
#   Set FIREBASE_SERVICE_ACCOUNT_JSON_BASE64 on the host. Then accounts,
#   sessions and data are all real, and this variable can be removed.
#
# SIGNALGOAT_ALLOW_DEV_AUTH is still accepted as a legacy name.
FUNDAGOAT_ALLOW_DEV_AUTH=""

# ------------------------------------------------------------------
# 14. CLOUDFLARE REALTIME WORKER  (SERVER ONLY)
# ------------------------------------------------------------------
# TradingVibes' live rooms need a Cloudflare Worker: one Durable Object per
# room holds the shared chart, the drawings and the presence list, and the
# Worker also owns the R2 bucket that holds avatars and room covers.
#
# THE WORKER IS A SEPARATE DEPLOYMENT.
#
# These variables configure the API server. They do NOT configure the
# Worker, and deploying the web app does not deploy the Worker. The two
# have to be pointed at each other by hand.
#
#   ROOM_REALTIME_URL   the Worker's PUBLIC base url, e.g.
#                       https://tradingvibes-realtime.<subdomain>.workers.dev
#                       The browser needs it to open the room socket and to
#                       upload images. It is a public endpoint, not a
#                       credential: access is governed by the Firebase ID
#                       token, never by hiding the url.
#   ROOM_REALTIME_SECRET  a long random string shared by the API server and
#                       the Worker. It signs upload tickets, delivery links
#                       and the service calls between them. It must be set
#                       as a Worker SECRET too:
#                         wrangler secret put ROOM_REALTIME_SECRET
#                       Never in the browser, never in a commit.
#
# The Worker additionally needs, in its own wrangler.toml / secrets:
#   ROOM_API_ORIGIN       this API server's base url
#   FIREBASE_PROJECT_ID   the Firebase project the ID tokens belong to
ROOM_REALTIME_URL=""
ROOM_REALTIME_SECRET=""

# ------------------------------------------------------------------
# 15. CLOUDFLARE REALTIME SFU  (SERVER ONLY) — ROOM VOICE
# ------------------------------------------------------------------
# The voice layer routes room audio through Cloudflare Realtime SFU. The
# browser never sees these values.
#
#   CLOUDFLARE_SFU_APP_ID   the SFU application's id
#   CLOUDFLARE_SFU_API_KEY  the SFU application's SECRET
#
# IMPORTANT: CLOUDFLARE_SFU_API_KEY must hold the SFU APP SECRET, not a
# general Cloudflare API token. The SFU Connection API authenticates with
# the app secret; an account-level API token is not interchangeable with it.
# If the value you have is an account token, put the app secret in
# CLOUDFLARE_SFU_BEARER_TOKEN instead — it takes precedence — and keep the
# account token for account management.
#
#   CLOUDFLARE_SFU_BEARER_TOKEN  optional, overrides CLOUDFLARE_SFU_API_KEY
#
# The account id and a general API key are useful for DEPLOYING the Worker
# and for managing buckets, but they are NOT used at runtime by the app:
#   CLOUDFLARE_ACCOUNT_ID
#   CLOUDFLARE_API_KEY
#
# Prefer a scoped API token with only the permissions the deployment needs.
CLOUDFLARE_SFU_APP_ID=""
CLOUDFLARE_SFU_API_KEY=""
CLOUDFLARE_SFU_BEARER_TOKEN=""

# ------------------------------------------------------------------
# 16. CLOUDFLARE R2  (OPTIONAL)
# ------------------------------------------------------------------
# The image bucket is bound to the Worker as `IMAGES`, so the app itself
# needs no bucket credentials. These names are for the cases where the
# bucket is addressed directly.
#
#   R2_PUBLIC_BASE_URL  if the bucket has a public domain, images are
#                       served from it and no signed delivery url is
#                       needed. Leave it EMPTY to keep the bucket private
#                       and serve images through the Worker's signed
#                       delivery route.
R2_PUBLIC_BASE_URL=""
