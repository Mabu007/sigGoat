# ==================================================================
# SignalGOAT — environment contract
# ==================================================================
# There are TWO different kinds of variable here, with two different
# delivery mechanisms. Mixing them up is the #1 deployment mistake:
#
#   1. VITE_*  — PUBLIC, browser-visible, inlined by Vite AT BUILD TIME.
#      -> MUST be present when `vite build` runs.
#      -> Vercel dashboard "Build" settings (not "Environment Variables"),
#         OR committed here (values are designed to be public anyway).
#      -> Setting these only at runtime does NOTHING: the bundle is already
#         built.
#
#   2. everything else — SERVER SECRETS, never sent to the browser.
#      -> Set ONLY in the Vercel dashboard "Environment Variables".
#      -> NEVER commit a real value here. Empty placeholders only.
# ==================================================================


# ------------------------------------------------------------------
# 1. FIREBASE — PUBLIC WEB CONFIG (Vite build-time)
# ------------------------------------------------------------------
# These identify the web client. They are not secrets: Firebase ships them
# to every browser. They are committed deliberately so the app can be
# built anywhere, including CI and preview deploys.
#
# Firebase project: sirvibes-44204
VITE_FIREBASE_API_KEY="AIzaSyCy-6HhG5cih6csrVZaNQ5ul7F_tC-i3k0"
VITE_FIREBASE_AUTH_DOMAIN="sirvibes-44204.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="sirvibes-44204"
VITE_FIREBASE_STORAGE_BUCKET="sirvibes-44204.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="778526817917"
VITE_FIREBASE_APP_ID="1:778526817917:web:46e94afeef939180903b14"
VITE_FIREBASE_MEASUREMENT_ID="G-JBRHZ5YDKF"

# Only set this if you use a NON-DEFAULT Firestore database.
# sirvibes-44204 uses the default database, so leave this EMPTY.
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# Set to "true" while developing against http://localhost. NEVER in
# production: it permits OAuth redirects from any loopback port.
VITE_FIREBASE_AUTH_EMULATORS="false"


# ------------------------------------------------------------------
# 2. FIREBASE — SERVER SERVICE ACCOUNT (Vercel env var only)
# ------------------------------------------------------------------
# The server must verify Firebase ID tokens and read/write Firestore.
# The public web keys above CANNOT do this. Generate the JSON from:
#   Firebase console -> Project settings -> Service accounts ->
#   "Generate new private key"
#
# Vercel stores multi-line env vars poorly, so prefer the BASE64 form.
# Generate it locally with:
#   base64 -w0 firebase-service-account.json
#
# Then set ONLY this one variable in Vercel.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=""

# Fallback for local development, where a real multi-line .json file is
# fine. Point at a git-ignored file. Ignored if the BASE64 form is set.
GOOGLE_APPLICATION_CREDENTIALS=""

# Alternative: use Application Default Credentials (Cloud Run / GCE).
# Only needs the project id; no JSON required.
FIREBASE_PROJECT_ID=""


# ------------------------------------------------------------------
# 3. REASONING (Vercel env var only)
# ------------------------------------------------------------------
# Server-wide fallback key. Per-user BYOK keys saved in Settings take
# precedence and are resolved per request.
OPENROUTER_API_KEY=""


# ------------------------------------------------------------------
# 4. TELEGRAM (Vercel env var only)
# ------------------------------------------------------------------
# Server-wide fallback bot token; per-user tokens (Settings) win.
TELEGRAM_BOT_TOKEN=""

# When set, POST /api/telegram/webhook requires a matching
# x-telegram-bot-api-secret-token header.
TELEGRAM_WEBHOOK_SECRET=""


# ------------------------------------------------------------------
# 5. CLOUDFLARE (Vercel env var only)
# ------------------------------------------------------------------
# Intended for durable-object hosting of the per-GOAT actors.
# NOT YET WIRED — see README "Hosting" for why the current Express +
# in-process scheduler architecture cannot run on Vercel serverless.
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_ACCESS_KEY_ID=""
CLOUDFLARE_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET=""
CLOUDFLARE_R2_ENDPOINT=""


# ------------------------------------------------------------------
# 6. LOCAL DEVELOPMENT ONLY
# ------------------------------------------------------------------
# Explicit opt-in for running WITHOUT Firebase credentials.
# Accepts a plain x-dev-user-id header as identity.
# NEVER enable this in production.
SIGNALGOAT_ALLOW_DEV_AUTH="0"

# File-backed persistence directory when Firestore is unavailable.
DATA_DIR="./data"

PORT="3000"


# ------------------------------------------------------------------
# 7. GEMINI (Vercel env var only, optional)
# ------------------------------------------------------------------
GEMINI_API_KEY=""
APP_URL=""
